<?xml version="1.0"?>
<package format="3">
  <name>vehicle_model_nodes</name>
  <version>1.0.0</version>
  <description>Different vehicle models served as ROS2 nodes</description>
  <maintainer email="simon.sagmeister@tum.de">simon</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>vehicle_model_node</depend>
  <depend>vehicle_model_cpp</depend>
  <depend>rclcpp_components</depend>
  <!-- Drivetrains -->
  <depend>drivetrain_wheel_torque_cpp</depend>
  <depend>drivetrain_wheel_torque_communication_handler_cpp</depend>
  <!-- Steering Actuators -->
  <depend>steering_actuator_pt1_cpp</depend>
  <depend>steering_actuator_pt1_communication_handler_cpp</depend>
  <!-- Vehicle Dynamics Models -->
  <depend>vehicle_dynamics_double_track_cpp</depend>
  <!-- Subparts for the vehicle dynamics models -->
  <depend>tire_models_cpp</depend>
  <depend>aerodynamics_models_cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>