// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-docker-compose
{
	"name": "DevContainer",

	// Update the 'dockerComposeFile' list if you have more compose files or use different names.
	// The .devcontainer/docker-compose.yml file contains any overrides you need/want to make.
	"image": "devcontainer_simon:jazzy",

	// The optional 'workspaceFolder' property is the path VS Code should open by default when
	// connected. This is typically a file mount in .devcontainer/docker-compose.yml
	"workspaceFolder": "/dev_ws",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment the next line if you want start specific services in your Docker Compose config.
	// "runServices": [],

	// Uncomment the next line if you want to keep your containers running after VS Code shuts down.
	// "shutdownAction": "none",

	// Uncomment the next line to run commands after the container is created.
	// "postCreateCommand": "cat /etc/os-release",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.pythonPath": "/bin/python3",
				"terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": { "bash": { "path": "/bin/zsh"} }
			},
			"extensions": [
				"SantaCodes.santacodes-region-viewer",
				"maptz.regionfolder",
				"Gruntfuggly.todo-tree",
				"redhat.vscode-xml",
				"ms-vscode-remote.remote-containers",
				"ms-vscode.cpptools",
				"ms-python.python",
				"ms-python.black-formatter",
				"mine.cpplint",
				"ms-vscode.cpptools-extension-pack",
				"ms-python.black-formatter",
				"ms-python.flake8",
				"mhutchie.git-graph"
			]
		}
	},

	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "ubuntu",
	"containerUser": "ubuntu",


    "mounts": [	"source=${localWorkspaceFolder},target=/dev_ws,type=bind,consistency=delegated",
				"source=${localEnv:HOME}/.zshrc,target=/home/ubuntu/.zshrc,type=bind,consistency=cached",
				"source=/usr/share/doc/fzf/examples/key-bindings.zsh,target=/usr/share/doc/fzf/examples/key-bindings.zsh,type=bind,consistency=cached",
				"source=${localEnv:HOME}/.oh-my-zsh,target=/home/ubuntu/.oh-my-zsh,type=bind,consistency=cached",
				"source=${localEnv:HOME}/.p10k.zsh,target=/home/ubuntu/.p10k.zsh,type=bind,consistency=cached",
				"source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached",
				"source=${localEnv:HOME}/.zsh_history,target=/home/ubuntu/.zsh_history,type=bind,consistency=cached",
			],
	// Define workspace
	//"remoteUser": "vscode",
	"runArgs": [
		"-e", "DISPLAY=${env:DISPLAY}",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix",
        "-v", "/etc/localtime:/etc/localtime:ro",
        "-v", "/dev/input:/dev/input",
		"--network=host",
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined",
		"--privileged"
		
	],
	"containerEnv": {
		"SHELL": "/bin/zsh",
		"LIBGL_ALWAYS_SOFTWARE": "1",
		"ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID}",
		"PYTHONWARNINGS": "ignore:::setuptools.command.install,ignore:::setuptools.command.easy_install,ignore:::pkg_resources"
	}
}